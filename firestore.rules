rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow read, write: if true;
    }
    match /menu_items/{itemId} {
      allow read, write: if true;
    }
    match /canteen_settings/{settingId} {
      allow read, write: if true;
    }
    match /monthly_reports/{reportId} {
      allow read, write: if true;
    }
  }
}
